<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. Permits cleartext HTTP so the app can talk to an API running on
  a development machine over the local network. This file is in src/debug and
  is never part of a release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
