<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uber_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Uber Brand Logo / Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="CargoResQ"
            android:textColor="@color/uber_pure_black"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.1"
            android:text="DRIVER COMPANION"
            android:textColor="@color/uber_teal"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="Move the rescue forward."
            android:textColor="@color/uber_black"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:text="Report breakdowns with 1-touch GPS, verify pallet handover cryptographic seals, and keep the cold chain visible."
            android:textColor="@color/uber_gray_muted"
            android:textSize="14sp" />

        <!-- Form Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API ENDPOINT"
                android:textColor="@color/uber_gray_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_endpoint"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_demo"
                android:hint="http://10.0.2.2:8000"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="http://10.0.2.2:8000"
                android:textColor="@color/uber_black"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="DRIVER EMAIL OR PHONE"
                android:textColor="@color/uber_gray_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Country code + input row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_pill_demo"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🇮🇳 +91"
                    android:textColor="@color/uber_black"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/input_email"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:hint="rajesh@apexpharma.com"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="rajesh@apexpharma.com"
                    android:textColor="@color/uber_black"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="PASSWORD"
                android:textColor="@color/uber_gray_muted"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/input_password"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_card"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Password123!"
                android:textColor="@color/uber_black"
                android:textSize="13sp" />

            <!-- Continue Button -->
            <LinearLayout
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_continue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in securely"
                    android:textColor="@color/uber_white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/uber_white" />
            </LinearLayout>

            <!-- One Click Demo Login -->
            <LinearLayout
                android:id="@+id/btn_demo_login"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_demo"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="One-Click Demo Login (Rajesh Kumar)"
                    android:textColor="@color/uber_teal"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Your carrier administrator provisions driver accounts and assigns rescue vehicles."
            android:textColor="@color/uber_gray_muted"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
