<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="26dp"
        android:gravity="center_vertical"
        android:minHeight="600dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CargoResQ"
            android:textColor="@color/ink"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DRIVER"
            android:textColor="@color/teal"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.14"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="30dp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVER ADDRESS" />

        <EditText
            android:id="@+id/input_base_url"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textUri"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:hint="http://192.168.1.10:8000"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:importantForAutofill="no" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMAIL" />

        <!-- No pre-filled credentials. The previous layout shipped a real
             email and the literal password "Password123!" inside the APK. -->
        <EditText
            android:id="@+id/input_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textEmailAddress"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:hint="you@carrier.example"
            android:autofillHints="emailAddress"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PASSWORD" />

        <EditText
            android:id="@+id/input_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:inputType="textPassword"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:hint="Your password"
            android:autofillHints="password"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/text_auth_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:visibility="gone"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btn_sign_in"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_pill_primary"
            android:text="Sign in"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/progress_auth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ask your dispatcher for your login. Your company creates driver accounts from the operations console."
            android:textColor="@color/muted"
            android:textSize="11sp"
            android:layout_marginTop="22dp" />
    </LinearLayout>
</ScrollView>
