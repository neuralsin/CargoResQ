<?xml version="1.0" encoding="utf-8"?>
<!--
  Safety guidance and emergency contacts.

  The do's and don'ts are cargo-aware: the correct advice for a reefer full of
  insulin is not the advice for a tanker of solvents, and generic guidance
  gets ignored.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Safety"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_safety_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Guidance for the load you are carrying."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IF YOU BREAK DOWN"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/list_dos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DO NOT"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/list_donts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY NUMBERS"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/list_emergency_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp">

            <TextView style="@style/CargoText.Eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="YOUR CONTACTS" />

            <Button
                android:id="@+id/btn_add_contact"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_pill_outline"
                app:backgroundTint="@null"
                android:text="Add"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="12sp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/list_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
