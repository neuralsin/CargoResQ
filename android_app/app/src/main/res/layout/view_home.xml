<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipe_home"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/text_driver_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Driver"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/text_truck_summary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No truck assigned"
                        android:textColor="@color/muted"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/badge_duty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_amber"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="OFF DUTY"
                    android:textColor="@color/amber"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!--
              The real map: osmdroid, OpenStreetMap tiles, and the device's
              genuine GPS fix. What this replaces was a flat coloured View
              with a 6dp rectangle rotated -15 degrees across it, captioned
              "14 MIN TRIP" as static text.
            -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card">

                <org.osmdroid.views.MapView
                    android:id="@+id/map_home"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="1dp" />

                <TextView
                    android:id="@+id/text_map_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_badge_teal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="Locating"
                    android:textColor="@color/teal"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_recentre"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_pill_outline"
                    app:backgroundTint="@null"
                    android:text="Recentre"
                    android:textAllCaps="false"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null" />
            </FrameLayout>

            <Button
                android:id="@+id/btn_duty_toggle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pill_primary"
                app:backgroundTint="@null"
                android:text="Go on duty"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <TextView
                android:id="@+id/text_telemetry_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Position sharing is off."
                android:textColor="@color/muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/card_incident"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_badge_red"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_incident_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Breakdown reported"
                    android:textColor="@color/red"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_incident_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink"
                    android:textSize="12sp" />

                <!-- The way out of a breakdown that turned out not to be one.
                     Hidden once the cargo has been handed over, because past
                     that point there is a real rescue in progress that has to
                     be resolved rather than erased. -->
                <Button
                    android:id="@+id/btn_stand_down"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="Back on the road - cancel"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_outline"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>



            <!-- What this phone is reporting right now.
                 A driver whose employer is tracking them should be able to
                 see exactly what is being sent, and whether it is getting
                 through. It also answers the first question anyone asks when
                 a dispatcher says they cannot see the truck. -->
            <LinearLayout
                android:id="@+id/card_telemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView style="@style/CargoText.Eyebrow"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="LIVE TELEMETRY" />

                    <TextView
                        android:id="@+id/text_telemetry_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="11sp"
                        android:text="Off duty" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_tele_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted"
                            android:textSize="10sp"
                            android:text="SPEED" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_tele_accuracy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted"
                            android:textSize="10sp"
                            android:text="GPS ACCURACY" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_tele_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ink"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:text="--" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted"
                            android:textSize="10sp"
                            android:text="BATTERY" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/text_tele_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- The other truck in a live rescue.
                 Sits directly under the incident card because when a rescue
                 is running this is the only thing either driver wants to
                 know: who is coming, and how far off they are. -->
            <LinearLayout
                android:id="@+id/card_counterpart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/text_counterpart_role"
                    style="@style/CargoText.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESCUER EN ROUTE" />

                <TextView
                    android:id="@+id/text_counterpart_distance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:text="--" />

                <TextView
                    android:id="@+id/text_counterpart_who"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_counterpart_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_call_counterpart"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:text="Call the other driver"
                    android:textSize="13sp"
                    android:background="@drawable/bg_pill_outline"
                    android:textColor="@color/ink"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView style="@style/CargoText.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CURRENT LOAD"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/card_shipment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_cargo_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No load assigned"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_cargo_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Your dispatcher has not assigned a shipment to this truck."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/row_cargo_conditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <!--
              Manual cold-chain reporting, labelled as manual. There is no
              temperature sensor in a phone, and the server records these as
              UNVERIFIED for exactly that reason.
            -->
            <LinearLayout
                android:id="@+id/card_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cargo temperature"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_condition_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Read the reefer gauge and record it. This log is what releases payment on delivery."
                    android:textColor="@color/muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <EditText
                        android:id="@+id/input_temperature"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:inputType="numberDecimal|numberSigned"
                        android:hint="4.2"
                        android:textColor="@color/ink"
                        android:textColorHint="@color/muted"
                        android:importantForAutofill="no" />

                    <Button
                        android:id="@+id/btn_log_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_pill_outline"
                        app:backgroundTint="@null"
                        android:text="Record"
                        android:textAllCaps="false"
                        android:textColor="@color/ink"
                        android:textSize="13sp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:stateListAnimator="@null" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btn_report_breakdown"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill_outline"
                app:backgroundTint="@null"
                android:text="Report a breakdown"
                android:textAllCaps="false"
                android:textColor="@color/red"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Use this when the truck cannot continue but nobody is hurt. For an injury or an accident, use SOS."
                android:textColor="@color/muted"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
