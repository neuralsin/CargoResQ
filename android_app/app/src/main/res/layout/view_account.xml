<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="110dp">

        <TextView
            android:id="@+id/text_account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_account_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASSIGNED VEHICLE"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_account_truck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No truck assigned"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_account_truck_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POSITION SHARING"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <!-- Said plainly. The driver is entitled to know exactly what is
                 collected and who can see it. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="While you are on duty, this app sends your position, speed and battery level to your own company. Your dispatcher sees it on their map."
                android:textColor="@color/ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Other companies never see your position, except while one of their loads is being rescued by your truck, and then only where you are."
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_account_telemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/teal"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVER"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_account_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_soft"
            android:padding="14dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_sign_out"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_pill_outline"
            app:backgroundTint="@null"
            android:text="Sign out"
            android:textAllCaps="false"
            android:textColor="@color/red"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>
</ScrollView>
