<?xml version="1.0" encoding="utf-8"?>
<!--
  The SOS screen.

  Designed for someone who is frightened, possibly injured, and holding the
  phone in one hand: large targets, a single scroll, and the call button
  reachable without choosing anything first.

  The disclaimer is repeated rather than tucked into a settings page. A driver
  must never believe an ambulance has been dispatched when what actually
  happened is that their dispatcher and some nearby trucks were told.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="110dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tell us what is happening. Your company and nearby trucks are alerted immediately."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <!-- Always first, always reachable. -->
        <Button
            android:id="@+id/btn_call_112"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill_danger"
            android:text="Call 112 now"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/psap_disclaimer"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/row_emergency_numbers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHAT IS WRONG" />

        <!-- Category tiles, filled in code so each one carries its own
             assistance type through to the network broadcast. -->
        <GridLayout
            android:id="@+id/grid_sos_categories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:layout_marginTop="10dp"
            android:useDefaultMargins="false" />

        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HOW SERIOUS"
            android:layout_marginTop="22dp" />

        <RadioGroup
            android:id="@+id/group_severity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_critical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Life threatening"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:buttonTint="@color/red" />

            <RadioButton
                android:id="@+id/radio_high"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Urgent, but not life threatening"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:checked="true"
                android:buttonTint="@color/amber" />

            <RadioButton
                android:id="@+id/radio_moderate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I need help when someone is free"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:buttonTint="@color/teal" />
        </RadioGroup>

        <!-- Condition. Every field optional: a driver with a broken arm must
             not be blocked by a required box, and "I don't know" is a real
             answer to most of these. -->
        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YOUR CONDITION (OPTIONAL)"
            android:layout_marginTop="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginTop="10dp">

            <CheckBox
                android:id="@+id/check_injured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Someone is injured"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:buttonTint="@color/red" />

            <CheckBox
                android:id="@+id/check_bleeding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Severe bleeding"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:buttonTint="@color/red" />

            <CheckBox
                android:id="@+id/check_trapped"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trapped in the cab"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:buttonTint="@color/red" />

            <CheckBox
                android:id="@+id/check_mobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="I can walk"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:checked="true"
                android:buttonTint="@color/teal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="People affected"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_persons"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="number"
                android:hint="1"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Anything else responders should know"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/input_condition_note"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:gravity="top"
                android:inputType="textMultiLine|textCapSentences"
                android:hint="Chest pain, cannot move my left arm"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:importantForAutofill="no" />
        </LinearLayout>

        <!-- A coordinate is precise but useless to a truck driver looking for
             you. A landmark is what actually gets someone to the scene. -->
        <TextView style="@style/CargoText.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WHERE ARE YOU"
            android:layout_marginTop="22dp" />

        <TextView
            android:id="@+id/text_sos_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Getting your position..."
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/input_landmark"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:inputType="textCapSentences"
            android:hint="km 42 marker, southbound"
            android:textColor="@color/ink"
            android:textColorHint="@color/muted"
            android:importantForAutofill="no" />

        <!-- Silent mode: for a driver who must not be seen raising an alarm. -->
        <CheckBox
            android:id="@+id/check_silent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Silent alert (no sound, no notification back to this phone)"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:buttonTint="@color/ink" />

        <Button
            android:id="@+id/btn_send_sos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_danger"
            android:text="Send SOS"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <TextView
            android:id="@+id/text_sos_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
