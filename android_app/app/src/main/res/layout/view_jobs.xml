<?xml version="1.0" encoding="utf-8"?>
<!--
  Rescue requests offered to this driver's truck.

  Carries no money. What a rescue is worth to the customer, and what the
  platform takes, are not the driver's to see; the dispatcher decides whether
  the job is worth taking. The driver sees where it is and what is involved.
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_jobs"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/canvas"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rescue requests"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Nearby loads that your truck can carry. Accepting commits you; the customer must also confirm before it is binding."
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/text_jobs_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:text="No requests right now.\n\nWhen a nearby truck breaks down with cargo yours can carry, it appears here."
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_jobs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="100dp" />
    </LinearLayout>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
