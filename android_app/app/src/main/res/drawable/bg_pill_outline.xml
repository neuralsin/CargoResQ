<?xml version="1.0" encoding="utf-8"?>
<!--
  A pill with an explicit pressed state.

  These used to be a single <shape>, so a press produced no visual change at
  all and the button felt dead. The state list gives the feedback that the
  Material ripple used to provide before the theme stopped converting these
  into MaterialButtons.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/line" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/card" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/line" />
        </shape>
    </item>
</selector>
